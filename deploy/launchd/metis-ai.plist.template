<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>YOUR_SERVICE_NAME</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string>
    <string>set -a; source "YOUR_INSTALL_DIR/.env"; set +a; exec YOUR_NODE_BIN YOUR_ENTRYPOINT</string>
  </array>
  <key>WorkingDirectory</key><string>YOUR_INSTALL_DIR</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>YOUR_DATA_DIR/YOUR_SERVICE_NAME.log</string>
  <key>StandardErrorPath</key><string>YOUR_DATA_DIR/YOUR_SERVICE_NAME.error.log</string>
</dict></plist>
