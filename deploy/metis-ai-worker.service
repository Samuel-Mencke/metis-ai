[Unit]
Description=Metis AI durable agent worker
After=network.target

[Service]
Type=simple
User=__METIS_USER__
WorkingDirectory=__METIS_DIR__
EnvironmentFile=__METIS_ENV__
ExecStart=/usr/bin/env node __METIS_DIR__/node_modules/tsx/dist/cli.mjs __METIS_DIR__/worker.ts
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
